NODE_ENV=development
PORT=4000
API_PREFIX=api/v1
DATABASE_URL=postgresql://code_forge:code_forge@localhost:5433/code_forge?schema=public
DATABASE_URL_UNPOOLED=postgresql://code_forge:code_forge@localhost:5433/code_forge?schema=public
GIT_STORAGE_PATH=../data/git
FRONTEND_ORIGIN=http://localhost:3000
GIT_PUBLIC_BASE_URL=http://localhost:3000
JWT_ACCESS_SECRET=local-only-change-this-secret-at-least-32-chars
# Local-only placeholder; must match frontend/.env for signed proxy IP headers.
RATE_LIMIT_PROXY_SECRET=local-only-change-this-proxy-secret-at-least-32-characters
TRUST_PROXY_HOPS=0
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
MAX_REPOSITORIES_PER_USER=20
MAX_REPOSITORY_BYTES=524288000
MAX_FILE_BYTES=26214400
MAX_PUSH_BYTES=104857600
SOFT_DELETE_RETENTION_DAYS=30
